# --- local, stdio (uvx / Claude Desktop) --------------------------------------
NEURALK_API_KEY=nk_live_your_key_here
# NEURALK_PREDICTION_URL=https://api.prediction.neuralk-ai.com
# SELDON_DEFAULT_MODEL=seldon-small
# Retention tier (days) for uploaded datasets: 1, 7, 30, or 90. Unset = Neuralk default (90).
# SELDON_UPLOAD_TTL_DAYS=7

# --- hosted, Streamable HTTP (deploy/) ----------------------------------------
# Every request must carry the client's own key; NEURALK_API_KEY is then unset.
# REQUIRE_CLIENT_API_KEY=true
# Public base URL the download links are built from.
# SELDON_PUBLIC_URL=https://mcp.neuralk.ai
# Where large-prediction download files are cached, and how long they live (seconds).
# SELDON_DOWNLOAD_DIR=/tmp/seldon-mcp-downloads
# SELDON_DOWNLOAD_TTL_SECONDS=300

# --- API-key validation against the neuralk-saas auth API (GET /api/v1/auth/whoami)
# SKIP_API_KEY_VALIDATION=false
# API_KEY_VALIDATION_TTL_S=300
# API_KEY_VALIDATION_TIMEOUT_S=5.0
